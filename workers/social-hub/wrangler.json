{
  "name": "social-hub",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "tahastudiolabs.com/api/vault/social/*",
      "zone_name": "tahastudiolabs.com"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "SITE_ORIGIN": "https://tahastudiolabs.com",
    "SOCIAL_CONSENT_VERSION": "s-1",
    "SOCIAL_CONNECTORS": "meta,facebook,instagram",
    "META_APP_ID": "29597448696547555",
    "META_CONFIG_ID": "1811497369998432",
    "META_GRAPH_VERSION": "v25.0",
    "SOCIAL_MAX_ATTEMPTS": "3",
    "SOCIAL_STUCK_MINUTES": "10",
    "ADMIN_EMAILS": "agborkak@gmail.com,hej@tahastudiolabs.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "brain-vault-db",
      "database_id": "94d97c77-2edb-43b9-906f-9e5051ae3bd0"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "brain-vault-files",
      "jurisdiction": "eu"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "SOCIAL_QUEUE",
        "queue": "social-publish"
      }
    ],
    "consumers": [
      {
        "queue": "social-publish",
        "max_batch_size": 5,
        "max_retries": 2
      }
    ]
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "observability": {
    "enabled": true
  },
  "images": {
    "binding": "IMAGES"
  }
}
